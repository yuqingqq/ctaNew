# DA forward-day verdict, nightly. PERSISTENT replacement for the transient
# unit created by systemd-run, which lived in /run/user/1001/systemd/transient
# on tmpfs and therefore did NOT survive a reboot: the nightly verdict would
# have stopped silently -- no failure, no log line, no artifact, because
# nothing runs to report that nothing ran (Q-DA-122, authorised R-255).
#
# Install:
#   install -Dm644 live/pm_research/systemd/da-midnight-verify.service \
#       ~/.config/systemd/user/da-midnight-verify.service
#   install -Dm644 live/pm_research/systemd/da-midnight-verify.timer \
#       ~/.config/systemd/user/da-midnight-verify.timer
#   systemctl --user stop da-midnight-verify.timer   # drop the transient pair
#   systemctl --user daemon-reload
#   systemctl --user enable --now da-midnight-verify.timer
#
# The script identifies this unit by /proc/self/cgroup and stamps
# `write_reason` into every verdict it writes (Q-DA-121). Do not add
# Environment=DA_WRITE_REASON here: the cgroup check is an identity test and
# an env var would be an assertion.
[Unit]
Description=DA forward-day verdict (P-2026-003) -- nightly day-quality verification

[Service]
# Type=oneshot, stated as a DELIBERATE difference from the transient unit
# (which defaulted to simple): the script runs to completion and exits, so
# systemd should wait for it and report its status rather than treat launch as
# success.
Type=oneshot
# ROUND 52: 2 IS A SUCCESS, AND THAT IS WHY THIS LINE EXISTS. The script's
# exit code is three-valued (0 clean / 2 OPEN_DAY_MASK_DEFERRED / 4 instrument
# failure). The open day that always sits in `days_needing_verdict` cannot
# have a mask six minutes after midnight -- the frozen detector refuses, which
# is correct -- so without this line the unit reports `failed` EVERY night
# while nothing is wrong, and a reader cannot distinguish that from a night
# when something is. Measured: rc=4 on 2026-09-05T00:06:29Z and again on
# 2026-09-06T00:06:41Z, both with the CLOSED day perfect. 4 is deliberately
# NOT listed here: a real instrument failure must still turn the unit red.
SuccessExitStatus=2
# RR9-3(a): NAME THE CANONICAL WRITE. The script refuses a run that
# identifies itself as neither this unit (by cgroup) nor an explicit
# production hand run, because a MIS-NAMED override sets neither
# DA_MIDNIGHT_OUTDIR nor DA_MIDNIGHT_LOG and is otherwise
# indistinguishable from a scheduled run -- how two 00:06Z verdicts
# were replaced at 10:16Z on 2026-09-02.
#
# This is REDUNDANT with the cgroup test ON PURPOSE, and it is not the
# same thing as the DA_WRITE_REASON the header forbids: that would be
# an ASSERTION OF IDENTITY, where this is a DECLARATION OF INTENT.
# `write_reason` still comes from the cgroup and cannot be spoofed by
# this line. The redundancy exists because a single new required
# variable on a nightly governed path is itself an outage risk: if it
# were dropped here, every 00:06Z verdict would refuse and nothing
# would run to say so.
Environment=DA_MIDNIGHT_MODE=production
# RR12-1: PIN THE VERIFIER. The script's own default is now
# script-relative so a worktree run uses the worktree's verifier; the
# production path is therefore NAMED here rather than inherited from
# wherever the script happens to sit. The script admits this as a PIN
# (same file as its own default) and still refuses a DIFFERENT binary
# outside a fully isolated rehearsal.
Environment=DA_MIDNIGHT_VERIFY_BIN=/home/yuqing/ctaNew/live/pm_research/da_forward_day_verify.py
OOMScoreAdjust=1000
ExecStart=/home/yuqing/ctaNew/live/pm_research/da_midnight_verify.sh
