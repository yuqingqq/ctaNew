+class AttemptState:
+    """Per-CONNECTION state: the producer and every consumer of it in one
+    object.
+
+    V41-RR3: with a free helper plus a hand-passed argument, the tests could
+    be green while PRODUCTION passed the coin-global delta -- Codex mutated
+    only the call site and the suite still exited 0. Encapsulating the state
+    means the same object that COUNTS the messages is the one the backoff and
+    the diagnostics read, so a call-site mutation has nothing coin-global to
+    reach for.
+    """
+
+    __slots__ = ("start_ns", "msgs", "last_recv_ns")
+
+    def __init__(self, start_ns: int) -> None:
+        self.start_ns = start_ns
+        self.msgs = 0
+        self.last_recv_ns = None
+
+    def record(self, recv_ns: int) -> None:
+        self.msgs += 1
+        self.last_recv_ns = recv_ns
+
+    def next_consec_fail(self, consec_fail: int) -> int:
+        """Backoff for the next reconnect, from THIS connection only."""
+        return 1 if self.msgs > 0 else consec_fail + 1
+
+    def diagnostics(self, now_ns: int) -> dict:
+        return connection_diagnostics(self.start_ns, self.msgs,
+                                      self.last_recv_ns, now_ns)
+
+
+def next_consec_fail(consec_fail: int, conn_msgs: int) -> int:
+    """Backoff counter for the NEXT reconnect, from ATTEMPT-LOCAL evidence.
+
+    Codex: the F3 code change was right but its behaviour was untested --
+    restoring the coin-global expression in a patched clone left the selftest
+    passing. Extracted so production and the test call the SAME function.
+
+    The defect it fixes: this read the COIN-GLOBAL message counter, so a
+    healthy SIBLING socket's traffic made a never-delivering connection look
+    like one that "worked, then died" and reset the backoff to 1. The coin
+    most likely to have a sibling -- the busiest -- was the least likely to
+    back off correctly, which is the opposite of what backoff is for.
+    """
+    return 1 if conn_msgs > 0 else consec_fail + 1
+
+
+def connection_diagnostics(conn_start_ns: int, conn_msgs: int,
+                           conn_last_recv_ns: int | None,
+                           now_ns: int) -> dict:
+    """Per-CONNECTION disconnect fields, from ATTEMPT-LOCAL state only.
+
+    Codex V41-F3 twice. First: computed from coin-global counters, so
+    overlapping current/next market tasks let a HEALTHY SIBLING socket credit
+    the failing one -- conn_msgs=7 for a socket that received zero. Then: the
+    fix was right but its test built its own dict and never touched
+    production, so a mutant restoring the broken expression PASSED.
+
+    Extracted so production and the test call the SAME code. A test that
+    cannot see the code it certifies is not a test.
+    """
+    return {
+        "conn_msgs": conn_msgs,
+        "conn_lifetime_s": round((now_ns - conn_start_ns) / 1e9, 3),
+        "silence_before_close_s": (
+            None if not conn_last_recv_ns else
+            round((now_ns - conn_last_recv_ns) / 1e9, 3)),
+    }
+
