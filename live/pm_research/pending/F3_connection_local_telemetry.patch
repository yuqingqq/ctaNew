+def _market_wiring_probe(deliver: int = 0) -> dict:
+    """Drive the REAL _market() loop and read the emitted disconnect row.
+
+    V41-RR3: unit tests on AttemptState were green while the PRODUCTION call
+    site could be mutated back to the coin-global delta -- Codex changed only
+    the argument and the suite still exited 0. A test that never runs
+    `_market()` cannot see how `_market()` wires its own state.
+
+    This runs one market whose socket delivers NOTHING and dies, while the
+    coin-global counter is pre-loaded to simulate a HEALTHY SIBLING. The
+    emitted row must report conn_msgs == 0. Restore the coin-global
+    expression at the call site and this fails, because the sibling's count
+    is exactly what it would return.
+    """
+    import asyncio as _a
+    import tempfile as _tf
+    import types as _ty
+
+    class _WS:
+        """`deliver` messages, then die. deliver=0 is the silent case."""
+
+        def __init__(self, *a, **k):
+            self.left = _WS.deliver
+
+        async def __aenter__(self): return self
+        async def __aexit__(self, *a): return False
+        async def send(self, m): pass
+
+        async def recv(self):
+            # A CONCURRENT SIBLING on the same coin. Codex V41-RR3 round 2:
+            # the first fixture PRELOADED msg_by_coin before _market() began,
+            # so `attempt_msgs` snapshotted the same value and the OLD
+            # expression `msg_by_coin - attempt_msgs` still returned the
+            # target's own count. The defect only exists when the sibling
+            # increments DURING the attempt -- which is the live shape, since
+            # discovery keeps overlapping current/next tasks per coin. A
+            # fixture that looks like the scenario without its essential
+            # property tests nothing.
+            _WS.owner.msg_by_coin["btc"] += 1
+            if self.left > 0:
+                self.left -= 1
+                await _real_sleep(0.001)
+                return json.dumps({"event_type": "book", "asset_id": "t1"})
+            raise ConnectionResetError("died (probe)")
+
+    _WS.deliver = deliver
+    _real_sleep = _a.sleep
+    _delays = []
+
+    global RAW, GAP_LEDGER, ROOT, WINDOW_S, GRACE_S, SUBSCRIBE_CONFIRM_S
+    _sv = (RAW, GAP_LEDGER, ROOT, WINDOW_S, GRACE_S, SUBSCRIBE_CONFIRM_S,
+           globals().get("websockets"))
+    with _tf.TemporaryDirectory() as td:
+        ROOT = Path(td); RAW = Path(td) / "raw"
+        GAP_LEDGER = Path(td) / "gaps.jsonl"
+        WINDOW_S, GRACE_S, SUBSCRIBE_CONFIRM_S = 1, 0, 0.2
+        globals()["websockets"] = _ty.SimpleNamespace(connect=_WS)
+
+        async def _rec_sleep(d):
+            if d > 0.4:
+                _delays.append(round(d, 2))
+                d = 0.001
+            await _real_sleep(d)
+        _sv_sleep = _a.sleep
+        _a.sleep = _rec_sleep
+        try:
+            c = PMCollector()
+            _WS.owner = c            # the sibling increments DURING attempts
+            ts = int(time.time())
+            _a.run(_a.wait_for(
+                c._market("btc-updown-5m-%d" % ts, ts, ["t1"]),
+                timeout=20))
+            rows = []
+            if GAP_LEDGER.exists():
+                for ln in GAP_LEDGER.read_text().splitlines():
+                    if ln.strip():
+                        rows.append(json.loads(ln))
+        finally:
+            _a.sleep = _sv_sleep
+            (RAW, GAP_LEDGER, ROOT, WINDOW_S, GRACE_S,
+             SUBSCRIBE_CONFIRM_S) = _sv[:6]
+            if _sv[6] is not None:
+                globals()["websockets"] = _sv[6]
+    d = [r for r in rows if r.get("event") == "disconnect"]
+    return {"n_disconnects": len(d),
+            "conn_msgs": d[0].get("conn_msgs") if d else None,
+            "all_conn_msgs": [r.get("conn_msgs") for r in d],
+            "delays": list(_delays),
+            # NOT delays[1] > delays[0]: the backoff is jittered, so two
+            # adjacent samples can rise by chance and a mutant pinning
+            # consec_fail=1 SURVIVED that assertion. Escalation means the
+            # sequence CLIMBS FAR above its own floor, which jitter around a
+            # fixed base cannot produce.
+            "escalating": (len(_delays) >= 4
+                           and max(_delays) >= 5 * min(_delays[:2])),
+            "delay_span": (round(min(_delays), 2), round(max(_delays), 2))
+            if _delays else None,
+            "coin_global": None}
+
