{
 "protocol": "P003_DA_POPULATION_FREEZE_V3",
 "version": 3,
 "declared_by": "DA 252",
 "declared_at_utc": "2026-09-11T10:35:03Z",
 "supersedes": {
  "file": "declarations/da_population_freeze_v2.json",
  "rule": "13 -- v1 and v2 unedited",
  "why": "v2's verifier REFUSED on de_preflight_matrix.py within minutes of landing -- CORRECTLY, on its own terms, and that was the defect: v2 mixed two classes of file under one rule. A freeze that refuses when an INSTRUMENT improves is a freeze that punishes the tooling for working."
 },
 "THE_SPLIT_RULED_AT_R_900_7": {
  "PIPELINE": "the pinned build modules, the valuation-path modules, the valuation import closure, the certificate, params v31, freeze chain v1..v10, the declarations, the masks and the artifacts. DRIFT REFUSES BY FILENAME.",
  "INSTRUMENT": "matrices, preflights, launchers, verifiers and the freeze-list generator. DRIFT IS REPORTED as INSTRUMENT_DRIFTED:<file> with old and new digest, EXIT 0 -- until the instrument freeze is called.",
  "when_the_instrument_freeze_is_called": "the coordinator, after DE 280 and BE 151 land",
  "why_the_split_is_not_a_weakening": "the two classes answer different questions. A PIPELINE byte changing means the object under test moved. An INSTRUMENT byte changing means the thing MEASURING it improved -- which is what we have been doing all morning, four tip moves' worth. Reporting one and refusing the other is the only way the freeze stays true without freezing our own hands."
 },
 "TREE_TIPS_ARE_PROVENANCE_THE_RULE_IS_THE_IDENTITY": {
  "WHY_NOT_A_TIP_LITERAL": "the wt-deval tip moved FOUR TIMES this morning on instrument landings alone -- 68e7d23 -> d3901f9 -> ... -> 9dca30a. A declaration pinned to a tip literal would have been stale within minutes of every landing, and re-declaring it each time teaches a reader that the number does not matter.",
  "THE_RULE": {
   "wt-fwd": "HEAD must be 7ed5a9015f75 or a DESCENDANT of it, AND every PIPELINE digest identical",
   "wt-deval": "HEAD must be 68e7d2352c7d7aed or a DESCENDANT of it, AND every PIPELINE digest identical"
  },
  "IDENTITY_IS_BY_DIGEST_NOT_BY_TIP": "a descendant that leaves every PIPELINE digest alone has changed nothing under test; a tip that matches a literal while a PIPELINE digest moved would pass a literal check and fail the real one. The digests are the identity; the tips are provenance.",
  "RECORDED_AS_PROVENANCE_AT_DECLARATION_TIME": {
   "wt-fwd": "7ed5a9015f75de64feeeeaad21d97e4eecc2b15c",
   "wt-deval": "9dca30aac283ad9c4d47864ad61533bc4c84e95b"
  }
 },
