+    """X5: the vectorised known state = AC.known_state on sampled steps of an order."""
+    bad = []; t = float(o.t); endj = int(A.endj_of(np.array([o.t_full]), np.array([o.g_struct]))[0]); js = np.arange(KP.J0, max(endj, KP.J0))
