 "rules": {
  "answer": "turnover_itself_poor: close net (fee_fill) <= 1e-09; good_turnover_lost_to_residual: close net > 1e-09 and residual value to resolution < -1e-09; else good_turnover_residual_not_negative; no_rows / no_resolved_markets / no_closes first; sensitivity: fees at resolution (close net_feeres; residual value - its fee_res)",
  "cohorts": "lot rows with ok 1s / 10s / 60s / END marks and a resolution; scope x role x depth x day; net = gross - fee_fill at marks, gross - fee_res at resolution; per share on own cohort shares and on the common denominator (all resolved lot shares of the scope and day)",
  "dust": "closes below 1e-06 shares stay in every sum, are flagged dust, never counted nor in holding-time quantiles",
  "lots": "status ok rows, self-trades out (pf_mt_econ.fifo); per address x market x day",
  "order": "econ FIFO order (settle_ms, sid, px_rank, mk_idx, maker first) and its per-side cumulative shares; unit j bought pairs unit j sold; a close = one interval of the merged boundaries in [0, min(bought, sold)], the cap taken from the final cumulative boundaries (never a separately rounded total); entry = the earlier leg, close = the later; hold = close settle_ms - entry settle_ms (UUIDv7 creation, the FIFO clock)",
  "population": "econ/identities.json ex_ante.top10_shares (ranks 1-3 = the contract top 3, all 10 = the benchmark); their fills_valued rows (maker and taker legs) on the measurement days, read per day through the row-group statistics of day; ok / excluded counts = maker_market",
  "reconcile": "vs econ maker_market per address x market x day, refusing: rows; attributed = mq / rq (tol 1e-09 + 1e-12 x traded shares); rt_pnl, rt_sh; gross identity; gross from rows; resid_res, resid_drift, net_pos, fee_fill, fee_res; net identity; fee proration; close shares = X; residual shares = |net position| (tolerance 1e-06 relative, floor 1)",
  "residual": "rq = q - attributed; value to END sum s rq (m_end - p), to resolution sum s rq (V - p), END->resolution (V - m_end) x net position; prorated fees; max |position| along the chronological lot path (self-trades out)",
  "summary": "closes in resolved markets (others counted); share-weighted holding-time quantiles (smallest hold reaching q of the shares) and the lower count median; residual_summary over resolved markets",
  "values": "P&L = shares x (sell - buy price), YES space, V-free; leg fees prorated by shares at the fill price (fee_fill, primary) and at resolution (fee_res, sensitivity)"
 },
