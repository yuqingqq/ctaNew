  "mechanism": "creation_context = the anonymous cell-creation context associated with a candidate first filler",
  "occupancy": "cell_occupied_at_window_lo / cell_empty_at_window_lo = the displayed size at the inferred posting-window lower endpoint, conditional on that window, with the post grade; never an actual-post queue label; population = top-3 orders that later filled",
  "roles": "earliest_set = the earliest record(s) under the premise; later_same_hash = a later fill of an order hash of the earliest set (the same order: no queue loss shown); later_other = later fills of other hashes; \"does the front pay?\" withdrawn (contract 5.3)",
  "speed": "speed_ms = the cell-event endpoint proxy with speed_lo_ms / speed_hi_ms; not a measured maker latency; endpoint ownership not assigned; no faster_than_others verdict",
  "status": "front_candidate = the one-address earliest set under the no-netting premise; never certified (review finding 1)",
  "timing": "book_candidate = the unique net decrease equal to the record quantity and claimed by no other record: a conditional timing candidate; an anonymous cancellation, replenishment or their netting inside a frame interval is not ruled out"
 },
