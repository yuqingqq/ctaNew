__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Data caches and downloads
data/
/tmp/
outputs/
!outputs/
outputs/*
!outputs/vBTC_final_simulation/
!outputs/vBTC_final_simulation/*.csv

# Trained model artifacts (regenerated via live/train_v6_clean_artifact.py).
# Selected deployment artifacts are kept tracked so a fresh git clone is enough
# to reproduce the documented deployment/research state.
# Note: must use `models/*` (exclude contents) not `models/` (exclude dir),
# otherwise the `!` exceptions below cannot re-include files.
models/*
!models/v6_clean_ensemble.pkl
!models/v6_clean_meta.json
!models/v6_clean_h*_ensemble.pkl
!models/v6_clean_h*_meta.json
!models/v7_xyz_ensemble.pkl
!models/v7_xyz_meta.json
!models/vBTC_production.pkl
!models/vBTC_production.json

# Live paper-trade runtime state
live/state/

# Claude Code local settings (skills are shared, the rest is local)
.claude/*
!.claude/skills/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local env
.env
.env.local

# Large data artifacts — NEVER commit (regenerated by the probes; a `git add -A` once
# swept ~42GB of these into history). The 3 small docs/xref/*.parquet xrefs predate this
# rule and stay tracked (gitignore does not untrack already-tracked files).
*.parquet
*.npy
*.feather
*.arrow
*.pt
*.h5
# Research/linear-model run outputs (per-cycle CSVs, prediction dumps, caches) are data, not code.
research/**/results/_cache/
linear_model/results/_cache/

# Live model artifacts: ignore all EXCEPT the two-book production models (~44MB, published via git so
# the live server pulls fresh models each month). Use `live/models/*` (contents) not `live/models/` (dir),
# else the `!` re-includes below can't take effect. Other ~940MB old vBTC/convexity .pkl stay local.
live/models/*
!live/models/twobook_flow_models.pkl
!live/models/twobook_price_models.pkl
!live/models/twobook_split.json
!live/models/convexity_v3_base_model.pkl
!live/models/convexity_v3_residrev_model.pkl

# large regenerable per-decision dumps (feature-window / gate-model audits)
live/V4_GATE_MODEL_DECISIONS.csv
live/V4_MODEL_REGIME_EDGE_24H_AUDIT.csv

# Nested repositories and git worktrees kept inside the checkout (each has its own history)
/pmmmrust/
/fv-pnl-integration/
/.snapshots/
/.worktrees/*
!/.worktrees/research_slot.sh

